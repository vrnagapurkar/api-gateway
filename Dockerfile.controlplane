# ---- build stage ----
FROM golang:1.22 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/controlplane ./cmd/controlplane

# ---- run stage ----
FROM gcr.io/distroless/static-debian12
WORKDIR /
COPY --from=build /out/controlplane /controlplane
EXPOSE 8081
USER nonroot:nonroot
ENTRYPOINT ["/controlplane"]
